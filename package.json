{
  "name": "turf-booking-api",
  "version": "2.0.0",
  "description": "Turf booking system with TypeORM",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/db/data.source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/db/data.source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/db/data.source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@aws-sdk/s3-request-presigner": "^3.962.0",
    "@react-email/components": "^1.0.4",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "^19.2.3",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.7.0",
    "speakeasy": "^2.0.0",
    "typeorm": "^0.3.17",
    "ua-parser-js": "^2.0.5",
    "whatsapp-web.js": "^1.34.4",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.4.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/speakeasy": "^2.0.10",
    "@types/ua-parser-js": "^0.7.39",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}